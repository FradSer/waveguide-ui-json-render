# Google Vertex AI
# Configure your Google Cloud project and location
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=us-central1

# Authentication: Use API Key for Express Mode
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GOOGLE_VERTEX_API_KEY=

# AI Model Configuration
# Override the default model used for UI generation
# Default: gemini-3.1-pro-preview
# Available models: gemini-3.1-pro-preview, gemini-2.0-flash-001, gemini-2.5-flash, gemini-2.5-pro, gemini-1.5-flash, gemini-1.5-pro
GOOGLE_VERTEX_MODEL=gemini-3.1-pro-preview
